# Example environment file. Copy to .env (which is gitignored) and fill in
# real values for local development. Never commit .env.

# [CUSTOMIZE] Replace with the variables your app actually needs.

# Application
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://user:password@localhost:5432/app

# Auth / sessions
JWT_SECRET=replace-with-a-long-random-string

# External services
# STRIPE_API_KEY=
# OPENAI_API_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
