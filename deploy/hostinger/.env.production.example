# GMN — variáveis de IMPLANTAÇÃO (sem segredos). Copie para /opt/gmn/.env.production NA VPS (chmod 600), preencha e NÃO versione.
# Os segredos (service role, anon key, Serper, senha e URL do Redis) são `docker secret`, nunca variáveis daqui.

# Domínio da aplicação (provisório; confirme e aponte o DNS A/AAAA para a VPS antes do deploy)
GMN_HOST=gmn.somosvra.com.br

# Tag das imagens carregadas na VPS (docker load): gmn-web:<tag> e gmn-worker:<tag>
GMN_IMAGE_TAG=1.0.0

# Nome do nó Swarm onde ficam os dados (docker node ls)
GMN_NODE_HOSTNAME=CONFIRMAR_NA_VPS

# Raiz dos dados persistentes (diretórios criados no guia, 0700, dono uid 10001)
GMN_DATA_ROOT=/srv/gmn

# Supabase EXISTENTE (URL pública do projeto) e bucket privado dos PDFs
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PRIVATE_AUDIT_BUCKET=gmn-audit-pdfs-private

# Operadores autorizados (e-mails separados por vírgula)
GMN_OPERATOR_EMAILS=operador@exemplo.com

# Nome do entrypoint HTTP (porta 80) do Traefik, para o redirecionamento para HTTPS (confirmar na VPS)
GMN_HTTP_ENTRYPOINT=web

# Concorrência do Worker (começar com 1: cada auditoria faz 49 consultas pagas)
GMN_WORKER_CONCURRENCY=1

# Réplicas do Worker. 0 = DESLIGADO (padrão e trava de custo). Só mude para 1 após a validação, e mantenha 1
# depois, senão cada novo `docker stack deploy` desliga o Worker (e interrompe uma auditoria em andamento).
GMN_WORKER_REPLICAS=0

# PROIBIDO em produção (o entrypoint recusa iniciar): GMN_AUTH_DISABLED, GMN_DEMO_MODE=true, NODE_ENV diferente de production.

# ---- Auditoria por Link: prova de ORIGEM e prova de COLETA (ver deploy/hostinger/PROVA-DE-ORIGEM-E-DE-COLETA.md) ----
# SEM VALORES REAIS neste arquivo. Os SEGREDOS (chave de origem; chaves aposentadas) NÃO entram aqui: são `docker secret`.
# Chaves PÚBLICAS de confiança para a prova de coleta (não são segredo): `<id>:<32 bytes da chave pública Ed25519 em base64url>`, separadas por vírgula.
# Vazio = prova de coleta NÃO configurada = nenhuma finalização (falha fechada, por desenho).
GMN_LINK_AUDIT_EVIDENCE_TRUST_KEYS=
# Identificadores (somente ids, nunca material) de chaves de ORIGEM REVOGADAS por comprometimento. Vazio na operação normal.
GMN_LINK_AUDIT_ORIGIN_REVOKED_KEY_IDS=
